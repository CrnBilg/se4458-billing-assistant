          },
          "month": {
            "type": "integer",
            "title": "Month"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "billTotal": {
            "type": "number",
            "title": "Billtotal"
          },
          "paidAmount": {
            "type": "number",
            "title": "Paidamount"
          },
          "remainingBalance": {
            "type": "number",
            "title": "Remainingbalance"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year",
          "billTotal",
          "paidAmount",
          "remainingBalance",
          "status"
        ],
        "title": "BillResponse"
      },
      "CalculateBillRequest": {
        "properties": {
          "subscriberNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,20}$",
            "title": "Subscriberno",
            "examples": [
              "5551001"
            ]
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "examples": [
