            "type": "integer",
            "title": "Extrablocks"
          },
          "additionalCharge": {
            "type": "number",
            "title": "Additionalcharge"
          },
          "charge": {
            "type": "number",
            "title": "Charge"
          }
        },
        "type": "object",
        "required": [
          "mb",
          "gb",
          "includedGb",
          "baseCharge",
          "extraBlocks",
          "additionalCharge",
          "charge"
        ],
        "title": "InternetBreakdown"
      },
      "PayBillRequest": {
        "properties": {
          "subscriberNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,20}$",
            "title": "Subscriberno",
            "examples": [
              "5551001"
            ]
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "examples": [
              10
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Year",
            "examples": [
              2026
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount"
          },
          "transactionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Transactionid"
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year",
          "amount",
          "transactionId"
        ],
        "title": "PayBillRequest"
      },
      "PayBillResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
