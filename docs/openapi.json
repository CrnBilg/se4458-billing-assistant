  "components": {
    "schemas": {
      "AddUsageRequest": {
        "properties": {
          "subscriberNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,20}$",
            "title": "Subscriberno",
            "examples": [
              "5551001"
            ]
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "examples": [
              10
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Year",
            "examples": [
              2026
            ]
          },
          "usageType": {
            "type": "string",
            "enum": [
              "Phone",
              "Internet"
            ],
            "title": "Usagetype"
          },
          "count": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Count",
            "description": "Number of usage events to record (each Phone event = 10 minutes, each Internet event = 1 MB). Defaults to 1 as in the assignment.",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year",
          "usageType"
        ],
        "title": "AddUsageRequest"
      },
      "AddUsageResponse": {
