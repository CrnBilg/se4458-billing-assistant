# For running the agent directly on your machine (python -m agent.cli).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# API Gateway URL (local docker compose or the Azure VM)
GATEWAY_URL=http://localhost:8000
# Leave empty to start the MCP server locally over stdio, or point to a deployed one:
MCP_SERVER_URL=
